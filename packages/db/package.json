    "test": "vitest run"
  },
  "dependencies": {
    "@sull/events": "workspace:*",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sull/tsconfig": "workspace:*",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }

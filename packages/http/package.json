{
  "name": "@sull/http",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sull/auth-sdk": "workspace:*",
    "@sull/errors": "workspace:*",
    "@sull/logger": "workspace:*",
    "fastify": "^5.11.3",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sull/tsconfig": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

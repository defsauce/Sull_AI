{
  "name": "sull-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Sull AI — Enterprise multi-tenant AI operating platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=./packages/* --filter=./services/*",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:security": "pnpm --filter @sull/security-tests test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "codegen": "turbo run codegen",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down -v",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "smoke": "node scripts/smoke-platform.mjs",
    "k8s:dev": "kubectl apply -k infra/kubernetes/overlays/dev",
    "tf:init": "cd infra/terraform/envs/dev && terraform init",
    "tf:plan": "cd infra/terraform/envs/dev && terraform plan",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@playwright/test": "^1.49.1",
    "@sull/eslint-config": "workspace:*",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}

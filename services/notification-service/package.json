{
  "name": "@sull/notification-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sull/auth-sdk": "workspace:*",
    "@sull/config": "workspace:*",
    "@sull/contracts": "workspace:*",
    "@sull/db": "workspace:*",
    "@sull/errors": "workspace:*",
    "@sull/events": "workspace:*",
    "@sull/http": "workspace:*",
    "@sull/kafka": "workspace:*",
    "@sull/logger": "workspace:*",
    "@sull/otel": "workspace:*",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sull/tsconfig": "workspace:*",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

{
  "name": "@sull/api-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sull/auth-sdk": "workspace:*",
    "@sull/config": "workspace:*",
    "@sull/errors": "workspace:*",
    "@sull/http": "workspace:*",
    "@sull/logger": "workspace:*",
    "@sull/otel": "workspace:*",
    "ioredis": "^5.4.2",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@sull/tsconfig": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
